# Copy to .env and fill in. NEVER commit .env or paste it into chats / AI tools.

# --- Required ---
MONGO_URI=mongodb://localhost:27017/met_ride
# The server refuses to start without a strong key (anyone could forge admin tokens otherwise).
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
PORT=5005

# --- Real email OTP (Brevo, free 300 emails/day) ---
# 1) brevo.com -> create account  2) Senders & IP -> add + verify a sender email
# 3) SMTP & API -> API Keys -> create key (starts with xkeysib-)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
MAIL_FROM_EMAIL=
# SMTP fallback (EMAIL_PROVIDER=smtp)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- Must be false for real use ---
BYPASS_EMAIL=false      # true = print OTP in the console instead of emailing
DEV_RETURN_OTP=false    # true = return OTP in the API response (INSECURE)
FLASK_DEBUG=false       # true = auto-reload + debugger (never on a shared network)
RATE_LIMIT_ENABLED=true

# --- Optional ---
CORS_ORIGINS=*          # Android does not need CORS; set your website origin if you have one

# --- Admin: created once at startup if missing (never overwrites a password) ---
ADMIN_EMAIL=
NEW_ADMIN_PASSWORD=     # delete this line after the first successful start
